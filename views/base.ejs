<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content="<%= config.siteDescription %>">
        <meta property="og:title" content="<%= page.isHomepage ? config.siteTitleMeta : (page.title + ' - ' + config.siteTitleMeta) %>">
        <meta property="og:description" content="<%= config.siteDescription %>">

        <% if (config.theme.favicon) { %>
            <link rel="icon" type="image/x-icon" href="/<%= config.theme.favicon %>">
        <% } else { %>
            <link rel="icon" type="image/x-icon" href="/assets/img/favicon.ico">
        <% } %>

        <title><% if (page && page.title && !page.isHomepage) { %><%= page.title %> - <% } %><%= config.siteTitleMeta %></title>

        <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Fira+Mono:400,700">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
        <link rel="stylesheet" href="/assets/css/bootstrap.min.css">
        <link rel="stylesheet" href="/assets/stylesheets/theme.css">
        <link rel="stylesheet" href="/assets/stylesheets/styles.css">

        <% if (config.theme.colors) { %>
            <style>
                :root {
                    <% if (config.theme.colors.text) { %>--text: var(--color-<%= config.theme.colors.text %>);<% } %>
                    <% if (config.theme.colors.title) { %>--title: var(--color-<%= config.theme.colors.title %>);<% } %>
                    <% if (config.theme.colors.primary) { %>--primary: var(--color-<%= config.theme.colors.primary %>);<% } %>
                    <% if (config.theme.colors.background) { %>--background: var(--color-<%= config.theme.colors.background %>);<% } %>
                }
            </style>
        <% } %>
    </head>

    <body>
        <div class="container py-3">
            <header>
                <%- include('partials/header') %>
            </header>

            <main>
                <%- include('partials/content') %>
            </main>

            <%- include('partials/preview') %>

            <%- include('partials/footer') %>
        </div>

        <script src="/assets/js/jquery-3.3.1.slim.min.js"></script>
        <script src="/assets/js/bootstrap.bundle.min.js"></script>
        <script src="/assets/js/theme.js"></script>
    </body>
</html>
